FROM rust:1-bookworm AS build
WORKDIR /src
COPY --chown=root:root . .
RUN sed -i '/^members = \[/,/^\]/c\members = ["apps/relay", "apps/defer", "apps/tape", "apps/rig", "libs/build-stamp", "libs/cli-std", "libs/metrics-prometheus", "libs/openapi-codegen", "libs/peer-tls", "libs/raft-core", "libs/raft-runtime", "libs/server-http", "libs/server-lifecycle", "libs/server-tcp", "libs/service-auth", "libs/service-backup", "libs/service-executor", "libs/service-http", "libs/service-k8s", "libs/service-observability", "libs/storage-durable", "libs/transport-h2c"]' Cargo.toml \
    && cargo build --release -p tape --bin tape --features operator \
    && cargo build --release -p defer --bin defer --features operator \
    && cargo build --release -p relay --bin relay --features operator

FROM debian:bookworm-slim AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM runtime AS tape
RUN groupadd --gid 65532 axiom \
    && useradd --uid 65532 --gid 65532 --create-home axiom
COPY --chown=axiom:axiom --from=build /src/target/release/tape /usr/local/bin/tape
USER 65532:65532
EXPOSE 7137 7138
ENTRYPOINT ["/usr/local/bin/tape"]

FROM runtime AS defer
RUN groupadd --gid 65532 axiom \
    && useradd --uid 65532 --gid 65532 --create-home axiom
COPY --chown=axiom:axiom --from=build /src/target/release/defer /usr/local/bin/defer
USER 65532:65532
EXPOSE 7141 7142
ENTRYPOINT ["/usr/local/bin/defer"]

FROM runtime AS relay
RUN groupadd --gid 65532 axiom \
    && useradd --uid 65532 --gid 65532 --create-home axiom
COPY --chown=axiom:axiom --from=build /src/target/release/relay /usr/local/bin/relay
USER 65532:65532
EXPOSE 7000 7001
ENTRYPOINT ["/usr/local/bin/relay"]
