# Source candidate only.  It intentionally has no Lumen build stage: Cloud
# Build's classic Docker daemon evaluates preceding stages for --target.
FROM rust:1.96-bookworm AS builder
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p sift --bin sift \
 && install -D -m 0755 target/release/sift /out/sift

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /out/sift /usr/local/bin/sift
ENV SIFT_HOST=0.0.0.0 \
    SIFT_PORT=7380 \
    SIFT_DATA_DIR=/var/lib/sift \
    SIFT_LOG_FORMAT=json
VOLUME ["/var/lib/sift"]
EXPOSE 7380
ENTRYPOINT ["/usr/local/bin/sift"]
CMD ["serve"]
