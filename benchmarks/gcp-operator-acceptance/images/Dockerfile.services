# syntax=docker/dockerfile:1

# One workspace build stage owns both binaries. Cloud Build targets the two
# distroless runtime stages separately and reuses this layer from its local
# Docker cache for the second target.
FROM rust:1.96-bookworm AS service-builder
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p lumen --bin lumen \
      --features "otel operator raft-wal jieba" \
 && cargo build --locked --release -p sift --bin sift \
 && install -D -m 0755 target/release/lumen /out/lumen \
 && install -D -m 0755 target/release/sift /out/sift

FROM gcr.io/distroless/cc-debian12:nonroot AS lumen
COPY --from=service-builder /out/lumen /usr/local/bin/lumen
EXPOSE 7373
ENTRYPOINT ["/usr/local/bin/lumen"]
CMD ["serve"]

FROM gcr.io/distroless/cc-debian12:nonroot AS sift
COPY --from=service-builder /out/sift /usr/local/bin/sift
ENV SIFT_HOST=0.0.0.0 \
    SIFT_PORT=7380 \
    SIFT_DATA_DIR=/var/lib/sift \
    SIFT_LOG_FORMAT=json
VOLUME ["/var/lib/sift"]
EXPOSE 7380
ENTRYPOINT ["/usr/local/bin/sift"]
CMD ["serve"]
