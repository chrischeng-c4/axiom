{
  "description": "Repository policy hooks for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|Agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git -c core.fsmonitor=false rev-parse --show-toplevel)/.codex/hooks/require_spawn_agent_effort.py\"",
            "timeout": 5,
            "statusMessage": "Checking subagent effort"
          }
        ]
      }
    ]
  }
}
