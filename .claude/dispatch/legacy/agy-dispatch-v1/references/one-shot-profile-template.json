{
  "controller_root": "/absolute/path/to/your/checkout",
  "root": "filled-in-by-the-worktree-verb",
  "repo": "owner/repository",
  "agy_project_id": "the-one-registered-agy-project-id-for-this-work-area",
  "state_dir": "/tmp/agy-dispatch/registered-agy-project-id",
  "mode": "measure-only",
  "task_contract": {
    "kind": "measurement",
    "session_policy": "one-shot",
    "run_id": "adhoc-20260731-unique-slug",
    "intent": "Inspect one bounded condition and return exact evidence.",
    "design_inputs": []
  },
  "model": "gemini-3.6-flash-high",
  "timeout": "30m",
  "inject_prompt_file": "/absolute/path/to/optional-task-prompt.md",
  "project_permissions": {
    "allow": [
      "command(pwd)",
      "command(git rev-parse)",
      "command(git status)",
      "command(git diff)",
      "command(rg)",
      "command(sed)",
      "command(shasum)"
    ],
    "deny": [
      "command(rm -rf)",
      "command(git push)",
      "command(git commit)",
      "command(git add)",
      "command(git checkout)",
      "command(git reset)",
      "command(git restore)",
      "command(git stash)",
      "command(git worktree)"
    ],
    "ask": [],
    "require_empty_global": true
  },
  "task_commands": {
    "allow": [
      "pwd",
      "git rev-parse HEAD",
      "git status --short",
      "rg -n 'EXACT_SELECTOR' src/allowed-file.rs",
      "sed -n '1,220p' src/allowed-file.rs",
      "shasum -a 256 /absolute/path/to/pinned-artifact"
    ],
    "deny": [
      "git push origin main",
      "git commit -am forbidden"
    ]
  },
  "protected_artifacts": [
    {"path": "repo/relative/pinned-artifact", "sha256": "replace-with-current-sha256"}
  ],
  "snapshot_paths": ["src", "tests"],
  "allowed_repo_writes": [],
  "path_change_budgets": {}
}
