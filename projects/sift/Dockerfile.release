# HANDWRITE-BEGIN gap="sift-release-image-artifact" tracker="1606" reason="Provide the verified release-binary Sift image contract."
FROM debian:bookworm-slim
ARG SIFT_VERSION=REPLACE_ME
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
         amd64) target="x86_64-unknown-linux-gnu" ;; \
         arm64) target="aarch64-unknown-linux-gnu" ;; \
         *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/chrischeng-c4/axiom/releases/download/sift@${SIFT_VERSION}/sift-${target}.tar.gz" -o /tmp/sift.tar.gz \
    && tar -xzf /tmp/sift.tar.gz -C /tmp \
    && install -m 755 "/tmp/sift-${target}/sift" /usr/local/bin/sift \
    && rm -rf /tmp/sift.tar.gz "/tmp/sift-${target}"
ENV SIFT_HOST=0.0.0.0 \
    SIFT_PORT=7380 \
    SIFT_DATA_DIR=/var/lib/sift \
    SIFT_LOG_FORMAT=json
VOLUME ["/var/lib/sift"]
EXPOSE 7380
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/sift"]
CMD ["serve"]
# HANDWRITE-END
