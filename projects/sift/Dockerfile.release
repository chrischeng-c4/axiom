# HANDWRITE-BEGIN gap="sift-release-image-artifact" tracker="1606" reason="Provide the verified release-binary Sift image contract."
# Production image for sift — a fully static musl release binary in a
# digest-pinned distroless runtime (no shell, apt, or curl in the final image).
# The sibling `Dockerfile` is the from-source build for dev / CI.
#
# Two binary sources feed the one runtime stage:
#   SOURCE=fetch  (default) downloads the published sift@<SIFT_VERSION> musl
#                 tarball plus its `.sha256` sidecar, verifies the checksum,
#                 and unpacks the binary — the post-release consumer path.
#   SOURCE=staged copies dist/linux/<TARGETARCH>/sift from the build context.
#                 sift-release-candidate.yml stages the exact candidate
#                 archives there, so the candidate image is built once from
#                 those bytes and never rebuilt or re-fetched at promotion.
#
# The image arch selects the matching linux tarball. BuildKit supplies
# TARGETARCH per requested platform and overrides the fetch stage's default:
#   --platform linux/amd64 → x86_64-unknown-linux-musl
#   --platform linux/arm64 → aarch64-unknown-linux-musl
# GitHub's Ubuntu release runners can advance past the glibc in a Debian
# runtime; musl removes that coupling entirely.
ARG SOURCE=fetch

# ---- stage 1a: fetch + verify the release binary (needs shell + curl) --------
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS binary-source-fetch
ARG SIFT_VERSION=REPLACE_ME
ARG TARGETARCH=amd64
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) target="x86_64-unknown-linux-musl" ;; \
      arm64) target="aarch64-unknown-linux-musl" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/chrischeng-c4/axiom/releases/download/sift@${SIFT_VERSION}"; \
    asset="sift-${target}.tar.gz"; \
    cd /tmp; \
    curl -fsSL "${base}/${asset}" -o "${asset}"; \
    curl -fsSL "${base}/${asset}.sha256" -o "${asset}.sha256"; \
    sha256sum -c - <"${asset}.sha256"; \
    tar -xzf "${asset}" -C /tmp --strip-components=1 "sift-${target}/sift"; \
    /tmp/sift --version

# ---- stage 1b: copy the pre-staged candidate binary (workflow path) ----------
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS binary-source-staged
ARG TARGETARCH
COPY dist/linux/${TARGETARCH}/sift /tmp/sift

FROM binary-source-${SOURCE} AS binary-source

# ---- stage 2: distroless static runtime — only the binary, nonroot (uid 65532)
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --chown=65532:65532 --from=binary-source /tmp/sift /usr/local/bin/sift
ENV SIFT_HOST=0.0.0.0 \
    SIFT_PORT=7380 \
    SIFT_DATA_DIR=/var/lib/sift \
    SIFT_LOG_FORMAT=json
VOLUME ["/var/lib/sift"]
EXPOSE 7380
ENTRYPOINT ["/usr/local/bin/sift"]
CMD ["serve"]
# HANDWRITE-END
