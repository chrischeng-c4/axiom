{
  "case_id": "server-timing-response-attribution-security",
  "minimum_checks": 11,
  "checks": [
    {
      "name": "a_separator_bearing_phase_name_cannot_forge_a_second_metric",
      "expected": [
        "db__forged",
        "db_dur_0",
        "a_b"
      ],
      "observed": [
        "db__forged",
        "db_dur_0",
        "a_b"
      ],
      "passed": true
    },
    {
      "name": "a_newline_in_a_phase_name_cannot_split_the_header",
      "expected": [
        "db__X-Evil__1",
        "a_b",
        false
      ],
      "observed": [
        "db__X-Evil__1",
        "a_b",
        false
      ],
      "passed": true
    },
    {
      "name": "a_non_ascii_phase_name_is_replaced_character_by_character",
      "expected": [
        "___",
        "db_",
        "_"
      ],
      "observed": [
        "___",
        "db_",
        "_"
      ],
      "passed": true
    },
    {
      "name": "an_empty_or_fully_replaced_name_falls_back_to_a_fixed_token",
      "expected": [
        "phase",
        "_",
        "__",
        "phase;dur=0.000"
      ],
      "observed": [
        "phase",
        "_",
        "__",
        "phase;dur=0.000"
      ],
      "passed": true
    },
    {
      "name": "the_permitted_extra_characters_survive_verbatim",
      "expected": [
        "db_read",
        "db-read",
        "db.read",
        "Db0"
      ],
      "observed": [
        "db_read",
        "db-read",
        "db.read",
        "Db0"
      ],
      "passed": true
    },
    {
      "name": "the_default_posture_never_leaks_a_phase_name",
      "expected": [
        false,
        "app;dur=1.000",
        1
      ],
      "observed": [
        false,
        "app;dur=1.000",
        1
      ],
      "passed": true
    },
    {
      "name": "a_hidden_phase_is_retained_and_can_surface_on_a_later_full_render",
      "expected": [
        "app;dur=1.000",
        1,
        true
      ],
      "observed": [
        "app;dur=1.000",
        1,
        true
      ],
      "passed": true
    },
    {
      "name": "a_full_render_prevents_the_next_response_from_repeating_it",
      "expected": [
        "app;dur=1.000, first_response;dur=1.000",
        "app;dur=1.000",
        []
      ],
      "observed": [
        "app;dur=1.000, first_response;dur=1.000",
        "app;dur=1.000",
        []
      ],
      "passed": true
    },
    {
      "name": "the_baseline_name_cannot_be_pushed_over",
      "expected": [
        "app;dur=0.000, app;dur=0.000",
        "app;dur=0.000"
      ],
      "observed": [
        "app;dur=0.000, app;dur=0.000",
        "app;dur=0.000"
      ],
      "passed": true
    },
    {
      "name": "a_negative_or_huge_duration_still_renders_a_bounded_token",
      "expected": [
        "-1.000",
        "0.000",
        "1000000000.000",
        "db;dur=-0.000"
      ],
      "observed": [
        "-1.000",
        "0.000",
        "1000000000.000",
        "db;dur=-0.000"
      ],
      "passed": true
    },
    {
      "name": "rendering_is_total_and_still_produces_a_header",
      "expected": [
        "accepted",
        "phase",
        "accepted",
        "phase;dur=0.000",
        "accepted",
        "app;dur=0.000",
        "accepted",
        "0.000"
      ],
      "observed": [
        "accepted",
        "phase",
        "accepted",
        "phase;dur=0.000",
        "accepted",
        "app;dur=0.000",
        "accepted",
        "0.000"
      ],
      "passed": true
    }
  ],
  "passed": true
}