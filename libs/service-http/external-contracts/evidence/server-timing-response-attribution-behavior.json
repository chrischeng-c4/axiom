{
  "case_id": "server-timing-response-attribution-behavior",
  "minimum_checks": 12,
  "checks": [
    {
      "name": "the_baseline_metric_is_always_present",
      "expected": [
        "app;dur=1.500",
        "app;dur=0.000",
        "app;dur=1.500"
      ],
      "observed": [
        "app;dur=1.500",
        "app;dur=0.000",
        "app;dur=1.500"
      ],
      "passed": true
    },
    {
      "name": "a_duration_renders_as_milliseconds_with_three_places",
      "expected": [
        "1.500",
        "0.000",
        "0.000",
        "1000.000"
      ],
      "observed": [
        "1.500",
        "0.000",
        "0.000",
        "1000.000"
      ],
      "passed": true
    },
    {
      "name": "the_default_posture_hides_a_pushed_phase",
      "expected": [
        "app;dur=5.000",
        "total-only",
        1
      ],
      "observed": [
        "app;dur=5.000",
        "total-only",
        1
      ],
      "passed": true
    },
    {
      "name": "full_disclosure_reveals_the_phases_after_the_baseline",
      "expected": [
        "app;dur=5.000, db;dur=2.000, render;dur=1.000",
        "app;dur=5.000",
        3
      ],
      "observed": [
        "app;dur=5.000, db;dur=2.000, render;dur=1.000",
        "app;dur=5.000",
        3
      ],
      "passed": true
    },
    {
      "name": "the_phases_render_in_push_order",
      "expected": [
        [
          [
            "first",
            1000000
          ],
          [
            "second",
            2000000
          ]
        ],
        [
          "app;dur=3.000",
          "first;dur=1.000",
          "second;dur=2.000"
        ]
      ],
      "observed": [
        [
          [
            "first",
            1000000
          ],
          [
            "second",
            2000000
          ]
        ],
        [
          "app;dur=3.000",
          "first;dur=1.000",
          "second;dur=2.000"
        ]
      ],
      "passed": true
    },
    {
      "name": "a_full_render_drains_what_it_disclosed",
      "expected": [
        1,
        "app;dur=1.000, db;dur=1.000",
        0,
        "app;dur=1.000"
      ],
      "observed": [
        1,
        "app;dur=1.000, db;dur=1.000",
        0,
        "app;dur=1.000"
      ],
      "passed": true
    },
    {
      "name": "the_two_postures_are_told_apart_by_one_predicate_each",
      "expected": [
        true,
        false,
        true,
        false
      ],
      "observed": [
        true,
        false,
        true,
        false
      ],
      "passed": true
    },
    {
      "name": "a_metric_renders_as_a_token_and_a_duration",
      "expected": [
        "db;dur=2.000",
        "render;dur=0.000",
        "app;dur=0.001"
      ],
      "observed": [
        "db;dur=2.000",
        "render;dur=0.000",
        "app;dur=0.001"
      ],
      "passed": true
    },
    {
      "name": "a_response_with_no_phases_still_carries_the_baseline",
      "expected": [
        [],
        "app;dur=1.000",
        "app;dur=1.000"
      ],
      "observed": [
        [],
        "app;dur=1.000",
        "app;dur=1.000"
      ],
      "passed": true
    },
    {
      "name": "a_phase_carries_its_own_name_and_duration",
      "expected": [
        [
          "db",
          5
        ],
        true,
        "app;dur=0.000, db;dur=2.000"
      ],
      "observed": [
        [
          "db",
          5
        ],
        true,
        "app;dur=0.000, db;dur=2.000"
      ],
      "passed": true
    },
    {
      "name": "the_posture_values_are_the_documented_ones",
      "expected": [
        "total-only",
        "full",
        "total-only",
        true
      ],
      "observed": [
        "total-only",
        "full",
        "total-only",
        true
      ],
      "passed": true
    },
    {
      "name": "the_header_the_attribution_is_published_under_is_lower_case",
      "expected": [
        "server-timing",
        true,
        1
      ],
      "observed": [
        "server-timing",
        true,
        1
      ],
      "passed": true
    }
  ],
  "passed": true
}