{
  "case_id": "opt-in-admission-configuration-security",
  "minimum_checks": 12,
  "checks": [
    {
      "name": "an_unreadable_value_is_refused_and_names_its_own_key",
      "expected": [
        "InvalidValue",
        "LUMEN_ADMISSION_READ_CAPACITY",
        "abc",
        "LUMEN_ADMISSION_READ_CAPACITY must be a positive integer, got `abc`"
      ],
      "observed": [
        "InvalidValue",
        "LUMEN_ADMISSION_READ_CAPACITY",
        "abc",
        "LUMEN_ADMISSION_READ_CAPACITY must be a positive integer, got `abc`"
      ],
      "passed": true
    },
    {
      "name": "zero_is_not_a_positive_capacity",
      "expected": [
        "InvalidValue",
        null,
        1,
        0
      ],
      "observed": [
        "InvalidValue",
        null,
        1,
        0
      ],
      "passed": true
    },
    {
      "name": "a_signed_spaced_or_non_ascii_value_is_refused",
      "expected": [
        null,
        null,
        null,
        null,
        null,
        1
      ],
      "observed": [
        null,
        null,
        null,
        null,
        null,
        1
      ],
      "passed": true
    },
    {
      "name": "a_tuning_knob_with_no_capacity_behind_it_is_refused",
      "expected": [
        "OrphanedCommonSetting",
        "LUMEN_ADMISSION_REFILL_SECS",
        "LUMEN_ADMISSION_REFILL_SECS is set but no admission capacity is configured; set at least one capacity key or remove LUMEN_ADMISSION_REFILL_SECS"
      ],
      "observed": [
        "OrphanedCommonSetting",
        "LUMEN_ADMISSION_REFILL_SECS",
        "LUMEN_ADMISSION_REFILL_SECS is set but no admission capacity is configured; set at least one capacity key or remove LUMEN_ADMISSION_REFILL_SECS"
      ],
      "passed": true
    },
    {
      "name": "the_second_tuning_knob_is_refused_the_same_way",
      "expected": [
        "OrphanedCommonSetting",
        "LUMEN_ADMISSION_MAX_KEYS",
        "LUMEN_ADMISSION_MAX_KEYS is set but no admission capacity is configured; set at least one capacity key or remove LUMEN_ADMISSION_MAX_KEYS"
      ],
      "observed": [
        "OrphanedCommonSetting",
        "LUMEN_ADMISSION_MAX_KEYS",
        "LUMEN_ADMISSION_MAX_KEYS is set but no admission capacity is configured; set at least one capacity key or remove LUMEN_ADMISSION_MAX_KEYS"
      ],
      "passed": true
    },
    {
      "name": "a_tuning_knob_beside_a_capacity_is_accepted",
      "expected": [
        "AdmissionConfig",
        "AdmissionConfig"
      ],
      "observed": [
        "AdmissionConfig",
        "AdmissionConfig"
      ],
      "passed": true
    },
    {
      "name": "the_value_check_covers_every_key_not_only_the_capacities",
      "expected": [
        "InvalidValue",
        "LUMEN_ADMISSION_MAX_KEYS"
      ],
      "observed": [
        "InvalidValue",
        "LUMEN_ADMISSION_MAX_KEYS"
      ],
      "passed": true
    },
    {
      "name": "an_invalid_policy_names_the_class_and_the_reason",
      "expected": [
        "admission policy for class `write` is invalid: capacity must be positive",
        "InvalidPolicy",
        "K must be a positive integer, got `v`",
        "K is set but no admission capacity is configured; set at least one capacity key or remove K"
      ],
      "observed": [
        "admission policy for class `write` is invalid: capacity must be positive",
        "InvalidPolicy",
        "K must be a positive integer, got `v`",
        "K is set but no admission capacity is configured; set at least one capacity key or remove K"
      ],
      "passed": true
    },
    {
      "name": "a_refusal_is_returned_rather_than_raised",
      "expected": [
        "accepted",
        "accepted",
        "accepted",
        "AdmissionConfig"
      ],
      "observed": [
        "accepted",
        "accepted",
        "accepted",
        "AdmissionConfig"
      ],
      "passed": true
    },
    {
      "name": "an_unknown_error_value_has_no_sentence",
      "expected": [
        "TypeError",
        "TypeError",
        "accepted"
      ],
      "observed": [
        "TypeError",
        "TypeError",
        "accepted"
      ],
      "passed": true
    },
    {
      "name": "the_prefix_is_carried_verbatim_into_every_key",
      "expected": [
        "_ADMISSION_READ_CAPACITY",
        "A_B_ADMISSION_MAX_KEYS",
        "_ADMISSION_READ_CAPACITY",
        5
      ],
      "observed": [
        "_ADMISSION_READ_CAPACITY",
        "A_B_ADMISSION_MAX_KEYS",
        "_ADMISSION_READ_CAPACITY",
        5
      ],
      "passed": true
    },
    {
      "name": "a_config_is_immutable",
      "expected": [
        "FrozenInstanceError",
        "FrozenInstanceError",
        "FrozenInstanceError"
      ],
      "observed": [
        "FrozenInstanceError",
        "FrozenInstanceError",
        "FrozenInstanceError"
      ],
      "passed": true
    }
  ],
  "passed": true
}