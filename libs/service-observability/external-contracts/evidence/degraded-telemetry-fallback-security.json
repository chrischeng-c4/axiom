{
  "case_id": "degraded-telemetry-fallback-security",
  "minimum_checks": 10,
  "checks": [
    {
      "name": "an_endpoint_that_is_not_a_uri_is_an_invalid_endpoint_fallback",
      "expected": [
        [
          "OtelUnavailable",
          "not a url",
          "invalid_endpoint"
        ],
        "invalid_endpoint"
      ],
      "observed": [
        [
          "OtelUnavailable",
          "not a url",
          "invalid_endpoint"
        ],
        "invalid_endpoint"
      ],
      "passed": true
    },
    {
      "name": "a_scheme_other_than_http_or_https_is_refused",
      "expected": [
        false,
        false,
        false,
        [
          "OtelUnavailable",
          "ftp://collector:4317",
          "invalid_endpoint"
        ]
      ],
      "observed": [
        false,
        false,
        false,
        [
          "OtelUnavailable",
          "ftp://collector:4317",
          "invalid_endpoint"
        ]
      ],
      "passed": true
    },
    {
      "name": "an_authority_less_uri_is_refused_even_with_the_right_scheme",
      "expected": [
        false,
        false,
        [
          "OtelUnavailable",
          "http:///v1/traces",
          "invalid_endpoint"
        ]
      ],
      "observed": [
        false,
        false,
        [
          "OtelUnavailable",
          "http:///v1/traces",
          "invalid_endpoint"
        ]
      ],
      "passed": true
    },
    {
      "name": "an_empty_or_relative_endpoint_is_refused",
      "expected": [
        false,
        false,
        false,
        [
          "OtelUnavailable",
          "",
          "invalid_endpoint"
        ]
      ],
      "observed": [
        false,
        false,
        false,
        [
          "OtelUnavailable",
          "",
          "invalid_endpoint"
        ]
      ],
      "passed": true
    },
    {
      "name": "the_scheme_comparison_is_case_folded_by_the_uri_split",
      "expected": [
        true,
        true,
        [
          "Otel",
          "HTTP://collector:4317",
          "lumen",
          "1.2.3"
        ]
      ],
      "observed": [
        true,
        true,
        [
          "Otel",
          "HTTP://collector:4317",
          "lumen",
          "1.2.3"
        ]
      ],
      "passed": true
    },
    {
      "name": "an_invalid_endpoint_is_refused_whether_or_not_compiled_in",
      "expected": [
        [
          "OtelUnavailable",
          "bad",
          "invalid_endpoint"
        ],
        [
          "OtelUnavailable",
          "bad",
          "invalid_endpoint"
        ]
      ],
      "observed": [
        [
          "OtelUnavailable",
          "bad",
          "invalid_endpoint"
        ],
        [
          "OtelUnavailable",
          "bad",
          "invalid_endpoint"
        ]
      ],
      "passed": true
    },
    {
      "name": "the_rejected_endpoint_is_reported_back_for_the_operator",
      "expected": [
        "htp://collector:4317",
        "collector:4317"
      ],
      "observed": [
        "htp://collector:4317",
        "collector:4317"
      ],
      "passed": true
    },
    {
      "name": "no_unavailable_path_raises_so_a_bad_endpoint_cannot_fail_startup",
      "expected": [
        "accepted",
        "accepted",
        "accepted",
        "accepted"
      ],
      "observed": [
        "accepted",
        "accepted",
        "accepted",
        "accepted"
      ],
      "passed": true
    },
    {
      "name": "an_unset_endpoint_never_turns_into_a_dial",
      "expected": [
        [
          "LoggingOnly"
        ],
        true
      ],
      "observed": [
        [
          "LoggingOnly"
        ],
        true
      ],
      "passed": true
    },
    {
      "name": "resolving_builds_no_connection_so_it_is_safe_on_a_dead_host",
      "expected": [
        [
          "Otel",
          "http://192.0.2.1:4317",
          "lumen",
          "1.2.3"
        ],
        [
          "OtelUnavailable",
          "http://192.0.2.1:4317",
          "feature_disabled"
        ]
      ],
      "observed": [
        [
          "Otel",
          "http://192.0.2.1:4317",
          "lumen",
          "1.2.3"
        ],
        [
          "OtelUnavailable",
          "http://192.0.2.1:4317",
          "feature_disabled"
        ]
      ],
      "passed": true
    }
  ],
  "passed": true
}