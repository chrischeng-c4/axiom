{
  "case_id": "versioned-log-envelope-security",
  "minimum_checks": 12,
  "checks": [
    {
      "name": "an_absent_correlation_field_is_omitted_never_null",
      "expected": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message",
          "attributes"
        ],
        false
      ],
      "observed": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message",
          "attributes"
        ],
        false
      ],
      "passed": true
    },
    {
      "name": "a_valid_correlation_field_appears_in_the_published_slot_order",
      "expected": [
        [
          "trace_id",
          "span_id",
          "parent_span_id",
          "trace_flags",
          "request_id"
        ],
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message",
          "trace_id",
          "span_id",
          "parent_span_id",
          "trace_flags",
          "request_id",
          "attributes"
        ]
      ],
      "observed": [
        [
          "trace_id",
          "span_id",
          "parent_span_id",
          "trace_flags",
          "request_id"
        ],
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message",
          "trace_id",
          "span_id",
          "parent_span_id",
          "trace_flags",
          "request_id",
          "attributes"
        ]
      ],
      "passed": true
    },
    {
      "name": "the_serialized_keys_are_exactly_the_published_set",
      "expected": [
        true,
        true
      ],
      "observed": [
        true,
        true
      ],
      "passed": true
    },
    {
      "name": "a_caller_cannot_add_an_envelope_key_by_recording_one",
      "expected": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message",
          "attributes"
        ],
        "axiom.service.log.v1",
        "INFO"
      ],
      "observed": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message",
          "attributes"
        ],
        "axiom.service.log.v1",
        "INFO"
      ],
      "passed": true
    },
    {
      "name": "the_pretty_format_is_not_collector_compatible",
      "expected": [
        false,
        "pretty",
        true
      ],
      "observed": [
        false,
        "pretty",
        true
      ],
      "passed": true
    },
    {
      "name": "a_blank_service_name_is_refused_at_construction",
      "expected": [
        "IdentityError",
        "IdentityError",
        "IdentityError"
      ],
      "observed": [
        "IdentityError",
        "IdentityError",
        "IdentityError"
      ],
      "passed": true
    },
    {
      "name": "a_blank_version_is_refused_but_a_short_one_is_accepted",
      "expected": [
        "IdentityError",
        "IdentityError",
        "accepted"
      ],
      "observed": [
        "IdentityError",
        "IdentityError",
        "accepted"
      ],
      "passed": true
    },
    {
      "name": "the_identity_refusal_is_a_value_error",
      "expected": [
        "IdentityError",
        true
      ],
      "observed": [
        "IdentityError",
        true
      ],
      "passed": true
    },
    {
      "name": "a_newline_in_a_message_cannot_break_the_line_in_two",
      "expected": [
        0,
        true,
        "\"message\":\"first\\nsecond\""
      ],
      "observed": [
        0,
        true,
        "\"message\":\"first\\nsecond\""
      ],
      "passed": true
    },
    {
      "name": "a_newline_in_an_attribute_value_cannot_break_the_line",
      "expected": [
        0,
        "\"attributes\":{\"note\":\"a\\nb\",\"tab\":\"c\\td\",\"target\":\"axiom::server\"}}",
        2
      ],
      "observed": [
        0,
        "\"attributes\":{\"note\":\"a\\nb\",\"tab\":\"c\\td\",\"target\":\"axiom::server\"}}",
        2
      ],
      "passed": true
    },
    {
      "name": "a_non_ascii_message_survives_the_line_intact",
      "expected": [
        0,
        "\"message\":\"\u6eab\u5ea6\u4e0a\u5347\"",
        true
      ],
      "observed": [
        0,
        "\"message\":\"\u6eab\u5ea6\u4e0a\u5347\"",
        true
      ],
      "passed": true
    },
    {
      "name": "the_published_key_tuples_are_the_schema_ones",
      "expected": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message"
        ],
        [
          "trace_id",
          "span_id",
          "parent_span_id",
          "trace_flags",
          "request_id"
        ]
      ],
      "observed": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message"
        ],
        [
          "trace_id",
          "span_id",
          "parent_span_id",
          "trace_flags",
          "request_id"
        ]
      ],
      "passed": true
    }
  ],
  "passed": true
}