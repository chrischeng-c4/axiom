{
  "case_id": "versioned-log-envelope-behavior",
  "minimum_checks": 15,
  "checks": [
    {
      "name": "every_line_carries_the_one_schema_tag",
      "expected": [
        "axiom.service.log.v1",
        "axiom.service.log.v1",
        "axiom.service.log.v1"
      ],
      "observed": [
        "axiom.service.log.v1",
        "axiom.service.log.v1",
        "axiom.service.log.v1"
      ],
      "passed": true
    },
    {
      "name": "the_required_envelope_fields_are_always_present_in_order",
      "expected": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message"
        ],
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message"
        ]
      ],
      "observed": [
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message"
        ],
        [
          "schema",
          "timestamp",
          "severity",
          "service",
          "event",
          "message"
        ]
      ],
      "passed": true
    },
    {
      "name": "the_severity_and_service_identity_come_through_unchanged",
      "expected": [
        "INFO",
        {
          "name": "lumen",
          "version": "1.2.3"
        },
        "ERROR"
      ],
      "observed": [
        "INFO",
        {
          "name": "lumen",
          "version": "1.2.3"
        },
        "ERROR"
      ],
      "passed": true
    },
    {
      "name": "an_explicit_event_field_outranks_the_metadata_name",
      "expected": [
        "chosen",
        "chosen"
      ],
      "observed": [
        "chosen",
        "chosen"
      ],
      "passed": true
    },
    {
      "name": "an_absent_or_empty_event_field_falls_back_to_the_metadata_name",
      "expected": [
        "metadata_name",
        "metadata_name",
        "metadata_name"
      ],
      "observed": [
        "metadata_name",
        "metadata_name",
        "metadata_name"
      ],
      "passed": true
    },
    {
      "name": "a_span_level_event_name_is_used_when_the_event_carries_none",
      "expected": [
        "from_span",
        "from_span",
        "from_event"
      ],
      "observed": [
        "from_span",
        "from_span",
        "from_event"
      ],
      "passed": true
    },
    {
      "name": "an_explicit_message_is_published_as_recorded",
      "expected": [
        "hello",
        "hello"
      ],
      "observed": [
        "hello",
        "hello"
      ],
      "passed": true
    },
    {
      "name": "an_absent_message_falls_back_to_the_resolved_event_name",
      "expected": [
        "evt",
        "metadata_name",
        "metadata_name",
        "named"
      ],
      "observed": [
        "evt",
        "metadata_name",
        "metadata_name",
        "named"
      ],
      "passed": true
    },
    {
      "name": "neither_the_event_name_nor_the_message_is_ever_empty",
      "expected": [
        "metadata_name",
        "",
        true,
        true
      ],
      "observed": [
        "metadata_name",
        "",
        true,
        true
      ],
      "passed": true
    },
    {
      "name": "an_over_long_message_is_cut_to_the_published_value_bound",
      "expected": [
        4096,
        4096,
        4096
      ],
      "observed": [
        4096,
        4096,
        4096
      ],
      "passed": true
    },
    {
      "name": "an_over_long_event_name_is_cut_to_the_published_bound",
      "expected": [
        128,
        128,
        128
      ],
      "observed": [
        128,
        128,
        128
      ],
      "passed": true
    },
    {
      "name": "an_over_long_identity_is_cut_to_the_same_bound",
      "expected": [
        128,
        128
      ],
      "observed": [
        128,
        128
      ],
      "passed": true
    },
    {
      "name": "everything_that_is_not_an_envelope_field_becomes_an_attribute",
      "expected": [
        {
          "retries": 3,
          "target": "axiom::server",
          "user": "u1"
        },
        "attributes"
      ],
      "observed": [
        {
          "retries": 3,
          "target": "axiom::server",
          "user": "u1"
        },
        "attributes"
      ],
      "passed": true
    },
    {
      "name": "only_the_json_format_is_declared_collector_compatible",
      "expected": [
        true,
        "json",
        "json"
      ],
      "observed": [
        true,
        "json",
        "json"
      ],
      "passed": true
    },
    {
      "name": "one_event_serializes_to_exactly_one_line_of_json",
      "expected": [
        0,
        "{}",
        "{\"schema\":\"axiom.service.log.v1\",\"timestamp\":\"2026-01-01T00:00:00Z\",\"severity\":\"INFO\",\"service\":{\"name\":\"lumen\",\"version\":\"1.2.3\"},\"event\":\"metadata_name\",\"message\":\"metadata_name\",\"attributes\":{\"target\":\"axiom::server\",\"user\":\"u1\"}}"
      ],
      "observed": [
        0,
        "{}",
        "{\"schema\":\"axiom.service.log.v1\",\"timestamp\":\"2026-01-01T00:00:00Z\",\"severity\":\"INFO\",\"service\":{\"name\":\"lumen\",\"version\":\"1.2.3\"},\"event\":\"metadata_name\",\"message\":\"metadata_name\",\"attributes\":{\"target\":\"axiom::server\",\"user\":\"u1\"}}"
      ],
      "passed": true
    }
  ],
  "passed": true
}