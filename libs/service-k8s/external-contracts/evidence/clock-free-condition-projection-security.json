{
  "case_id": "clock-free-condition-projection-security",
  "minimum_checks": 12,
  "checks": [
    {
      "name": "the_same_inputs_project_to_the_same_result_every_time",
      "expected": [
        true,
        "2026-01-01T00:00:00Z"
      ],
      "observed": [
        true,
        "2026-01-01T00:00:00Z"
      ],
      "passed": true
    },
    {
      "name": "every_instant_comes_from_the_prior_or_the_caller_and_nowhere_else",
      "expected": [
        "2026-01-01T00:00:00Z",
        "2026-06-01T00:00:00Z",
        "2026-06-01T00:00:00Z"
      ],
      "observed": [
        "2026-01-01T00:00:00Z",
        "2026-06-01T00:00:00Z",
        "2026-06-01T00:00:00Z"
      ],
      "passed": true
    },
    {
      "name": "the_injected_instant_is_carried_through_byte_for_byte",
      "expected": [
        "2026-06-01T00:00:00Z",
        "2026-06-01T00:00:00.123456Z"
      ],
      "observed": [
        "2026-06-01T00:00:00Z",
        "2026-06-01T00:00:00.123456Z"
      ],
      "passed": true
    },
    {
      "name": "a_projected_condition_cannot_be_mutated_after_the_fact",
      "expected": "FrozenInstanceError",
      "observed": "FrozenInstanceError",
      "passed": true
    },
    {
      "name": "a_condition_fact_cannot_be_mutated_after_the_fact",
      "expected": "FrozenInstanceError",
      "observed": "FrozenInstanceError",
      "passed": true
    },
    {
      "name": "the_projection_returns_an_immutable_sequence",
      "expected": [
        "tuple",
        "AttributeError"
      ],
      "observed": [
        "tuple",
        "AttributeError"
      ],
      "passed": true
    },
    {
      "name": "a_stale_prior_cannot_smuggle_its_reason_or_message_forward",
      "expected": [
        "Issued",
        ""
      ],
      "observed": [
        "Issued",
        ""
      ],
      "passed": true
    },
    {
      "name": "a_prior_the_service_no_longer_reports_cannot_survive_on_its_own",
      "expected": [
        "Rotating"
      ],
      "observed": [
        "Rotating"
      ],
      "passed": true
    },
    {
      "name": "an_unknown_status_never_inherits_a_true_priors_instant",
      "expected": [
        "Unknown",
        "2026-06-01T00:00:00Z"
      ],
      "observed": [
        "Unknown",
        "2026-06-01T00:00:00Z"
      ],
      "passed": true
    },
    {
      "name": "the_observed_generation_always_comes_from_the_caller",
      "expected": [
        2,
        "2026-01-01T00:00:00Z"
      ],
      "observed": [
        2,
        "2026-01-01T00:00:00Z"
      ],
      "passed": true
    },
    {
      "name": "a_forged_prior_instant_is_honored_only_for_an_identical_status",
      "expected": [
        "2026-06-01T00:00:00Z",
        "1999-01-01T00:00:00Z"
      ],
      "observed": [
        "2026-06-01T00:00:00Z",
        "1999-01-01T00:00:00Z"
      ],
      "passed": true
    },
    {
      "name": "the_serialized_condition_exposes_no_field_the_service_did_not_set",
      "expected": [
        "lastTransitionTime",
        "message",
        "observedGeneration",
        "reason",
        "status",
        "type"
      ],
      "observed": [
        "lastTransitionTime",
        "message",
        "observedGeneration",
        "reason",
        "status",
        "type"
      ],
      "passed": true
    }
  ],
  "passed": true
}