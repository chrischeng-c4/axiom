{
  "case_id": "credential-reload-audit-security",
  "minimum_checks": 16,
  "checks": [
    {
      "name": "each_validation_violation_reports_its_own_reason",
      "expected": [
        "required_but_empty",
        "empty_key",
        "empty_subject",
        "empty_resource",
        "identity_key_not_an_email",
        "ok"
      ],
      "observed": [
        "required_but_empty",
        "empty_key",
        "empty_subject",
        "empty_resource",
        "identity_key_not_an_email",
        "ok"
      ],
      "passed": true
    },
    {
      "name": "an_empty_registry_is_admitted_when_authentication_is_not_required",
      "expected": "ok",
      "observed": "ok",
      "passed": true
    },
    {
      "name": "a_blank_key_and_a_blank_subject_are_not_the_same_violation",
      "expected": [
        "empty_key",
        "empty_subject"
      ],
      "observed": [
        "empty_key",
        "empty_subject"
      ],
      "passed": true
    },
    {
      "name": "an_identity_key_that_is_not_an_email_is_rejected_although_nothing_else_is_wrong",
      "expected": "identity_key_not_an_email",
      "observed": "identity_key_not_an_email",
      "passed": true
    },
    {
      "name": "the_identity_email_rule_admits_a_well_formed_address",
      "expected": "ok",
      "observed": "ok",
      "passed": true
    },
    {
      "name": "a_reserved_subject_in_the_token_namespace_is_reported_with_its_key_and_subject",
      "expected": [
        "tokens",
        "k",
        "system:masters"
      ],
      "observed": [
        "tokens",
        "k",
        "system:masters"
      ],
      "passed": true
    },
    {
      "name": "a_reserved_subject_in_the_identity_namespace_is_reported_with_its_key_and_subject",
      "expected": [
        "identities",
        "a@b.com",
        "system:masters"
      ],
      "observed": [
        "identities",
        "a@b.com",
        "system:masters"
      ],
      "passed": true
    },
    {
      "name": "a_registry_free_of_reserved_subjects_reports_no_violation",
      "expected": "none",
      "observed": "none",
      "passed": true
    },
    {
      "name": "a_reserved_subject_is_refused_before_anything_is_published",
      "expected": [
        0,
        0
      ],
      "observed": [
        0,
        0
      ],
      "passed": true
    },
    {
      "name": "the_authorization_event_carries_exactly_its_five_declared_fields",
      "expected": [
        "outcome",
        "reason",
        "subject",
        "resource",
        "needed"
      ],
      "observed": [
        "outcome",
        "reason",
        "subject",
        "resource",
        "needed"
      ],
      "passed": true
    },
    {
      "name": "the_reload_event_carries_exactly_its_four_declared_fields",
      "expected": [
        "applied",
        "revision",
        "entries",
        "failure"
      ],
      "observed": [
        "applied",
        "revision",
        "entries",
        "failure"
      ],
      "passed": true
    },
    {
      "name": "the_declared_field_tuples_agree_with_the_dataclasses_themselves",
      "expected": [
        true,
        true
      ],
      "observed": [
        true,
        true
      ],
      "passed": true
    },
    {
      "name": "a_denied_authorization_records_no_trace_of_the_credential",
      "expected": [
        false,
        false
      ],
      "observed": [
        false,
        false
      ],
      "passed": true
    },
    {
      "name": "an_allowed_authorization_records_no_trace_of_the_credential",
      "expected": false,
      "observed": false,
      "passed": true
    },
    {
      "name": "a_reload_event_records_no_trace_of_the_registry_it_published",
      "expected": [
        false,
        true
      ],
      "observed": [
        false,
        true
      ],
      "passed": true
    },
    {
      "name": "a_parse_failure_records_no_trace_of_the_document_that_failed",
      "expected": false,
      "observed": false,
