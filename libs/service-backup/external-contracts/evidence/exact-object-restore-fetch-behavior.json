{
  "case_id": "exact-object-restore-fetch-behavior",
  "minimum_checks": 11,
  "checks": [
    {
      "name": "a_local_object_uri_resolves_to_the_exact_path",
      "expected": [
        "LocalObject",
        "/var/lib/lumen/backup-1.json"
      ],
      "observed": [
        "LocalObject",
        "/var/lib/lumen/backup-1.json"
      ],
      "passed": true
    },
    {
      "name": "a_local_path_keeps_every_character_it_was_given",
      "expected": [
        "/a//b/",
        "/",
        "relative/x"
      ],
      "observed": [
        "/a//b/",
        "/",
        "relative/x"
      ],
      "passed": true
    },
    {
      "name": "an_object_store_uri_resolves_to_a_scheme_a_bucket_and_a_key",
      "expected": [
        "RemoteObject",
        "s3://",
        "axiom",
        "lumen/backup-1.json"
      ],
      "observed": [
        "RemoteObject",
        "s3://",
        "axiom",
        "lumen/backup-1.json"
      ],
      "passed": true
    },
    {
      "name": "a_single_segment_key_splits_the_same_way_a_nested_one_does",
      "expected": [
        "axiom",
        "one.json"
      ],
      "observed": [
        "axiom",
        "one.json"
      ],
      "passed": true
    },
    {
      "name": "the_split_takes_the_first_separator_not_the_last",
      "expected": [
        "axiom",
        "a/b/c.json"
      ],
      "observed": [
        "axiom",
        "a/b/c.json"
      ],
      "passed": true
    },
    {
      "name": "a_google_object_uri_carries_its_own_scheme_tag",
      "expected": [
        "RemoteObject",
        "gs://",
        "axiom",
        "a/b.json"
      ],
      "observed": [
        "RemoteObject",
        "gs://",
        "axiom",
        "a/b.json"
      ],
      "passed": true
    },
    {
      "name": "leading_separators_on_a_key_are_trimmed_and_internal_ones_survive",
      "expected": [
        "a//b.json",
        "a/b.json/",
        "k"
      ],
      "observed": [
        "a//b.json",
        "a/b.json/",
        "k"
      ],
      "passed": true
    },
    {
      "name": "whitespace_around_an_object_uri_is_trimmed",
      "expected": [
        "k",
        "/x",
        "axiom"
      ],
      "observed": [
        "k",
        "/x",
        "axiom"
      ],
      "passed": true
    },
    {
      "name": "the_object_reader_and_the_destination_writer_read_the_same_text_differently",
      "expected": [
        "RemoteObject",
        "lumen",
        "S3",
        "lumen",
        "MissingKey",
        "S3"
      ],
      "observed": [
        "RemoteObject",
        "lumen",
        "S3",
        "lumen",
        "MissingKey",
        "S3"
      ],
      "passed": true
    },
    {
      "name": "the_reader_accepts_the_same_three_schemes_as_the_writer",
      "expected": [
        "LocalObject",
        "RemoteObject",
        "RemoteObject",
        "UnsupportedScheme"
      ],
      "observed": [
        "LocalObject",
        "RemoteObject",
        "RemoteObject",
        "UnsupportedScheme"
      ],
      "passed": true
    },
    {
      "name": "a_resolved_object_compares_by_value_and_cannot_be_rewritten",
      "expected": [
        true,
        true,
        "FrozenInstanceError"
      ],
      "observed": [
        true,
        true,
        "FrozenInstanceError"
      ],
      "passed": true
    }
  ],
  "passed": true
}