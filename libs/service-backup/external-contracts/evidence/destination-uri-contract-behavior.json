  "checks": [
    {
      "name": "a_file_uri_resolves_to_a_local_path",
      "expected": [
        "Local",
        "/var/lib/lumen/backup",
        null
      ],
      "observed": [
        "Local",
        "/var/lib/lumen/backup",
        null
      ],
      "passed": true
    },
    {
      "name": "an_s3_uri_splits_bucket_then_prefix",
      "expected": [
        "S3",
        "axiom-backups",
