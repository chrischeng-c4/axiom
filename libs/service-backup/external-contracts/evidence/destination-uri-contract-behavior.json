      ],
      "observed": [
        "p",
        "p",
        "p//x",
        ""
      ],
      "passed": true
    },
    {
      "name": "a_gs_prefix_is_trimmed_the_same_way_an_s3_prefix_is",
      "expected": [
        "p",
        "p",
        "p//x",
