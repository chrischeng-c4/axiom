        "backup"
      ],
      "observed": [
        "",
        "backup",
        "p",
        "backup",
        "own",
        "backup"
      ],
      "passed": true
    },
    {
      "name": "an_identity_round_trips_a_parsed_destination",
      "expected": [
        "local:/var/lib/x",
