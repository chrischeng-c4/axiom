{
  "case_id": "authenticated-admin-snapshot-transport-security",
  "minimum_checks": 10,
  "checks": [
    {
      "name": "the_success_range_boundaries_are_exact",
      "expected": [
        "RemoteStatus",
        "NoneType",
        "NoneType",
        "RemoteStatus"
      ],
      "observed": [
        "RemoteStatus",
        "NoneType",
        "NoneType",
        "RemoteStatus"
      ],
      "passed": true
    },
    {
      "name": "every_status_outside_the_range_is_carried_rather_than_collapsed",
      "expected": [
        403,
        500,
        0,
        599
      ],
      "observed": [
        403,
        500,
        0,
        599
      ],
      "passed": true
    },
    {
      "name": "the_refusal_carries_the_status_and_the_body",
      "expected": [
        403,
        "admin token rejected",
        "RemoteStatus"
      ],
      "observed": [
        403,
        "admin token rejected",
        "RemoteStatus"
      ],
      "passed": true
    },
    {
      "name": "the_refusal_sentence_names_both",
      "expected": "admin snapshot request failed with status 403: admin token rejected",
      "observed": "admin snapshot request failed with status 403: admin token rejected",
      "passed": true
    },
    {
      "name": "a_body_that_looks_like_a_status_line_is_still_only_a_body",
      "expected": [
        502,
        "HTTP/1.1 200 OK",
        "admin snapshot request failed with status 502: HTTP/1.1 200 OK"
      ],
      "observed": [
        502,
        "HTTP/1.1 200 OK",
        "admin snapshot request failed with status 502: HTTP/1.1 200 OK"
      ],
      "passed": true
    },
    {
      "name": "an_empty_body_is_carried_as_an_empty_body",
      "expected": [
        "",
        true,
        "admin snapshot request failed with status 500: "
      ],
      "observed": [
        "",
        true,
        "admin snapshot request failed with status 500: "
      ],
      "passed": true
    },
    {
      "name": "a_multi_line_body_is_not_truncated",
      "expected": [
        "line one\nline two",
        17,
        1
      ],
      "observed": [
        "line one\nline two",
        17,
        1
      ],
      "passed": true
    },
    {
      "name": "a_success_classification_carries_nothing_at_all",
      "expected": [
        true,
        true,
        true,
        false
      ],
      "observed": [
        true,
        true,
        true,
        false
      ],
      "passed": true
    },
    {
      "name": "a_classification_never_raises",
      "expected": [
        "accepted",
        "accepted",
        "accepted",
        "RemoteStatus"
      ],
      "observed": [
        "accepted",
        "accepted",
        "accepted",
        "RemoteStatus"
      ],
      "passed": true
    },
    {
      "name": "an_unknown_error_variant_has_no_sentence",
      "expected": [
        "accepted",
        "TypeError",
        "TypeError",
        "admin snapshot request failed with status 1: a"
      ],
      "observed": [
        "accepted",
        "TypeError",
        "TypeError",
        "admin snapshot request failed with status 1: a"
      ],
      "passed": true
    }
  ],
  "passed": true
}