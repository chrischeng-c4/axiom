{
  "case_id": "retained-object-write-behavior",
  "minimum_checks": 12,
  "checks": [
    {
      "name": "a_run_reports_the_sink_the_key_the_size_and_the_prune_count",
      "expected": [
        "s3://axiom/lumen",
        "lumen/backup-1767225600.json",
        4096,
        1767225600,
        0
      ],
      "observed": [
        "s3://axiom/lumen",
        "lumen/backup-1767225600.json",
        4096,
        1767225600,
        0
      ],
      "passed": true
    },
    {
      "name": "the_wire_summary_uses_camel_case_keys",
      "expected": [
        [
          "object",
          "pruned"
        ],
        [
          "sink",
          "key",
          "bytes",
          "unixSeconds"
        ]
      ],
      "observed": [
        [
          "object",
          "pruned"
        ],
        [
          "sink",
          "key",
          "bytes",
          "unixSeconds"
        ]
      ],
      "passed": true
    },
    {
      "name": "the_wire_summary_carries_the_same_values_the_plan_reported",
      "expected": {
        "object": {
          "sink": "s3://axiom/lumen",
          "key": "lumen/backup-1767225600.json",
          "bytes": 10,
          "unixSeconds": 1767225600
        },
        "pruned": 2
      },
      "observed": {
        "object": {
          "sink": "s3://axiom/lumen",
          "key": "lumen/backup-1767225600.json",
          "bytes": 10,
          "unixSeconds": 1767225600
        },
        "pruned": 2
      },
      "passed": true
    },
    {
      "name": "an_absent_maximum_age_prunes_nothing",
      "expected": [
        0,
        []
      ],
      "observed": [
        0,
        []
      ],
      "passed": true
    },
    {
      "name": "a_finite_maximum_age_selects_only_what_is_older_than_the_cutoff",
      "expected": [
        "lumen/backup-1767139200.json"
      ],
      "observed": [
        "lumen/backup-1767139200.json"
      ],
      "passed": true
    },
    {
      "name": "the_expiry_comparison_is_strict_on_the_cutoff_second",
      "expected": [
        [],
        [
          "lumen/backup-1767225600.json"
        ],
        1
      ],
      "observed": [
        [],
        [
          "lumen/backup-1767225600.json"
        ],
        1
      ],
      "passed": true
    },
    {
      "name": "an_object_this_crate_did_not_write_is_left_alone",
      "expected": [
        "lumen/backup-1.json"
      ],
      "observed": [
        "lumen/backup-1.json"
      ],
      "passed": true
    },
    {
      "name": "the_prefix_used_for_pruning_is_normalized_first",
      "expected": [
        [
          "lumen/backup-1.json"
        ],
        [
          "lumen/backup-1.json"
        ],
        "lumen",
        "lumen",
        ""
      ],
      "observed": [
        [
          "lumen/backup-1.json"
        ],
        [
          "lumen/backup-1.json"
        ],
        "lumen",
        "lumen",
        ""
      ],
      "passed": true
    },
    {
      "name": "a_local_key_and_an_object_store_key_have_different_shapes",
      "expected": [
        "backup-1767225600.json",
        "lumen/backup-1767225600.json",
        "lumen/backup-1767225600.json",
        "backup-1767225600.json"
      ],
      "observed": [
        "backup-1767225600.json",
        "lumen/backup-1767225600.json",
        "lumen/backup-1767225600.json",
        "backup-1767225600.json"
      ],
      "passed": true
    },
    {
      "name": "a_sink_kind_with_no_key_shape_is_refused_and_a_raw_prefix_is_normalized",
      "expected": [
        "ValueError",
        "lumen/backup-1767225600.json"
      ],
      "observed": [
        "ValueError",
        "lumen/backup-1767225600.json"
      ],
      "passed": true
    },
    {
      "name": "a_key_carries_the_timestamp_it_was_built_from",
      "expected": [
        "lumen/backup-1767225600.json",
        "backup-1767225600.json",
        "a/b/backup-1767225600.json",
        "backup-1767225600.json"
      ],
      "observed": [
        "lumen/backup-1767225600.json",
        "backup-1767225600.json",
        "a/b/backup-1767225600.json",
        "backup-1767225600.json"
      ],
      "passed": true
    },
    {
      "name": "the_listing_prefix_ends_at_a_path_segment_boundary",
      "expected": [
        "lumen/",
        null,
        "a/b/"
      ],
      "observed": [
        "lumen/",
        null,
        "a/b/"
      ],
      "passed": true
    }
  ],
  "passed": true
}