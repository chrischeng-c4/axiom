        "EmptySchedule",
        "BackupPolicy"
      ],
      "observed": [
        "EmptySchedule",
        "BackupPolicy"
      ],
      "passed": true
    },
    {
      "name": "a_whitespace_only_schedule_is_refused_too",
      "expected": [
        "EmptySchedule",
        "EmptySchedule",
        "EmptySchedule",
        "EmptySchedule"
      ],
      "observed": [
        "EmptySchedule",
        "EmptySchedule",
        "EmptySchedule",
        "EmptySchedule"
      ],
      "passed": true
    },
    {
      "name": "the_blankness_test_reads_the_same_way_when_called_directly",
      "expected": [
        true,
        true,
        true,
        false,
        false
      ],
      "observed": [
        true,
        true,
        true,
        false,
        false
      ],
      "passed": true
    },
    {
      "name": "an_unparseable_destination_fails_at_admission",
      "expected": [
