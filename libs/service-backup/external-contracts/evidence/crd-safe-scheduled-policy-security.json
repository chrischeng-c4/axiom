        "EmptySchedule",
        "UnsupportedScheme"
      ],
      "observed": [
        "EmptySchedule",
        "EmptySchedule",
        "UnsupportedScheme"
      ],
      "passed": true
    },
    {
      "name": "an_admitted_schedule_is_carried_through_byte_for_byte",
      "expected": [
        " 0 3 * * * ",
        true,
