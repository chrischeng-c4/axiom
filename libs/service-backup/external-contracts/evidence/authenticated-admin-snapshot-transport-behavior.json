{
  "case_id": "authenticated-admin-snapshot-transport-behavior",
  "minimum_checks": 10,
  "checks": [
    {
      "name": "the_endpoint_path_is_fixed",
      "expected": [
        "/admin/backup",
        "http://localhost:8080/admin/backup"
      ],
      "observed": [
        "/admin/backup",
        "http://localhost:8080/admin/backup"
      ],
      "passed": true
    },
    {
      "name": "trailing_separators_on_the_base_url_do_not_double_the_join",
      "expected": [
        "http://h:1/admin/backup",
        "http://h:1/admin/backup",
        "http://h:1/admin/backup",
        "http://h:1/api/admin/backup",
        "http://h:1/api/admin/backup"
      ],
      "observed": [
        "http://h:1/admin/backup",
        "http://h:1/admin/backup",
        "http://h:1/admin/backup",
        "http://h:1/api/admin/backup",
        "http://h:1/api/admin/backup"
      ],
      "passed": true
    },
    {
      "name": "the_base_url_is_otherwise_carried_through_unchanged",
      "expected": [
        "https://lumen.example.com:8443/admin/backup",
        "/admin/backup",
        "/admin/backup"
      ],
      "observed": [
        "https://lumen.example.com:8443/admin/backup",
        "/admin/backup",
        "/admin/backup"
      ],
      "passed": true
    },
    {
      "name": "an_authorized_request_carries_exactly_one_header",
      "expected": [
        [
          "authorization"
        ],
        1,
        {
          "authorization": "Bearer tok"
        }
      ],
      "observed": [
        [
          "authorization"
        ],
        1,
        {
          "authorization": "Bearer tok"
        }
      ],
      "passed": true
    },
    {
      "name": "the_header_value_splits_into_a_scheme_label_and_the_token",
      "expected": [
        "Bearer ",
        "tok",
        "Bearer",
        "tok",
        "Bearer "
      ],
      "observed": [
        "Bearer ",
        "tok",
        "Bearer",
        "tok",
        "Bearer "
      ],
      "passed": true
    },
    {
      "name": "the_header_name_is_the_standard_lower_case_spelling",
      "expected": [
        "authorization",
        true,
        false
      ],
      "observed": [
        "authorization",
        true,
        false
      ],
      "passed": true
    },
    {
      "name": "an_absent_token_sends_no_header_at_all",
      "expected": [
        {},
        0,
        [],
        false
      ],
      "observed": [
        {},
        0,
        [],
        false
      ],
      "passed": true
    },
    {
      "name": "the_empty_string_is_a_present_token",
      "expected": [
        {
          "authorization": "Bearer "
        },
        1,
        "Bearer "
      ],
      "observed": [
        {
          "authorization": "Bearer "
        },
        1,
        "Bearer "
      ],
      "passed": true
    },
    {
      "name": "the_token_is_carried_byte_for_byte",
      "expected": [
        "Bearer a b",
        "Bearer   t  ",
        "Bearer Bearer x"
      ],
      "observed": [
        "Bearer a b",
        "Bearer   t  ",
        "Bearer Bearer x"
      ],
      "passed": true
    },
    {
      "name": "a_successful_response_classifies_to_nothing",
      "expected": [
        null,
        null,
        null
      ],
      "observed": [
        null,
        null,
        null
      ],
      "passed": true
    }
  ],
  "passed": true
}