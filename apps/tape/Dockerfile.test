# HANDWRITE-BEGIN gap="tape-test-image-dockerfile" tracker="2576" reason="Per-commit GHCR dev/test image variant of Dockerfile.release — COPY a locally built binary instead of downloading a published release tarball; never tagged latest/semver."
# syntax=docker/dockerfile:1
# Internal dev/test image for tape — NEVER user-facing (see #2576). COPY
# variant of `Dockerfile.release`: same runtime stage (distroless
# static-debian12, entrypoint, port, ownership) but takes the binary from
# the build context instead of downloading a published release tarball, so
# it can be built from an unreleased commit. That is the whole point:
# without it, proving a fix in GKE means cutting a release first, which is
# how 0.4.5→0.4.11 happened.
#
# Produced by `.github/workflows/tape-test-image.yml` and pushed ONLY as
# `ghcr.io/<owner>/tape:sha-<git12>` — that workflow must never add a
# `latest` or semver tag to this image. The release line (`tape:<semver>`
# + `latest`) stays exclusively on `Dockerfile.release` via
# `tape-release.yml`. Both lines land on the same GHCR package, so this
# image inherits that package's public visibility and GKE can pull a
# `sha-*` tag anonymously.
#
# Expects the workflow to have staged per-arch release-profile binaries into
# the build context before invoking buildx:
#   dist/linux/amd64/tape
#   dist/linux/arm64/tape
#
#   docker buildx build -f apps/tape/Dockerfile.test \
#     --platform linux/amd64,linux/arm64 \
#     -t ghcr.io/<owner>/tape:sha-<git12> --push .

# distroless static runtime — only the binary + CA certs, nonroot. Identical
# to Dockerfile.release's runtime stage: static-debian12 ships no
# glibc/libgcc, so this only works with the fully static musl binaries the
# workflow builds. :nonroot = uid 65532. A single tokio binary handles
# SIGTERM itself and spawns no children, so no tini/init shim is required.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH=amd64
COPY --chown=65532:65532 dist/linux/${TARGETARCH}/tape /usr/local/bin/tape
# 7137 = client API. No CMD, matching Dockerfile.release: every deployment
# path names its own verb (the operator renders `command: [tape, serve]`
# for the server StatefulSet and `[tape]` + args for the operator/backup
# workloads), so a default subcommand here would only ever be shadowed.
EXPOSE 7137
ENTRYPOINT ["/usr/local/bin/tape"]
# HANDWRITE-END
