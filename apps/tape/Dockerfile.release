# syntax=docker/dockerfile:1
# Production image for tape — downloads a PUBLISHED release binary (no source
# tree, no Rust toolchain) into a distroless runtime. Tiny + minimal attack
# surface (no shell/apt/curl in the final image). The sibling `Dockerfile` is
# the from-source build for dev / CI.
#
#   docker build -f apps/tape/Dockerfile.release -t tape:0.4.10 \
#     --build-arg TAPE_VERSION=tape@0.4.10 .
#
# The image arch (BuildKit TARGETARCH) selects the matching MUSL tarball —
# the runtime stage is glibc-free distroless/static (lumen's #1195 pattern),
# so a static binary is required; a gnu binary built on a newer-glibc runner
# cannot even load in the bookworm fetch stage (GLIBC_2.38+):
#   --platform linux/amd64 → x86_64-unknown-linux-musl
#   --platform linux/arm64 → aarch64-unknown-linux-musl

# ---- stage 1: fetch + verify the release binary (needs shell + curl) --------
FROM debian:bookworm-slim AS fetch
ARG TAPE_VERSION=tape@0.4.10
ARG TAPE_REPO=chrischeng-c4/axiom
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) t=x86_64-unknown-linux-musl ;; \
      arm64) t=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/${TAPE_REPO}/releases/download/${TAPE_VERSION}"; \
    curl -fsSL "${base}/tape-${t}.tar.gz"        -o /tmp/tape.tgz; \
    curl -fsSL "${base}/tape-${t}.tar.gz.sha256" -o /tmp/tape.sha256; \
    echo "$(cat /tmp/tape.sha256)  /tmp/tape.tgz" | sha256sum -c -; \
    tar -xzf /tmp/tape.tgz -C /tmp --strip-components=1 "tape-${t}/tape"; \
    /tmp/tape --version

# ---- stage 2: distroless runtime — only the binary + CA certs, nonroot -------
FROM gcr.io/distroless/static-debian12:nonroot
COPY --chown=65532:65532 --from=fetch /tmp/tape /usr/local/bin/tape
EXPOSE 7137
ENTRYPOINT ["/usr/local/bin/tape"]
