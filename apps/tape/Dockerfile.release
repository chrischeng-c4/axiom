# syntax=docker/dockerfile:1
# Production image for tape — downloads a PUBLISHED release binary (no source
# tree, no Rust toolchain) into a distroless runtime. Tiny + minimal attack
# surface (no shell/apt/curl in the final image). The sibling `Dockerfile` is
# the from-source build for dev / CI.
#
#   docker build -f apps/tape/Dockerfile.release -t tape:0.5.0 \
#     --build-arg TAPE_VERSION=tape@0.5.0 .
#
# The image arch selects the matching linux tarball. BuildKit supplies
# TARGETARCH for each requested target platform. Each stage redeclares that
# automatic argument without a value so a multi-platform build cannot silently
# use one architecture for both images. A non-BuildKit builder must pass
# TARGETARCH explicitly:
#   --platform linux/amd64 → x86_64-unknown-linux-musl
#   --platform linux/arm64 → aarch64-unknown-linux-musl

ARG SOURCE=fetch

# ---- stage 1a: fetch + verify the release binary (needs shell + curl) --------
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS binary-source-fetch
ARG TAPE_VERSION=tape@0.5.0
ARG TAPE_REPO=chrischeng-c4/axiom
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) t=x86_64-unknown-linux-musl ;; \
      arm64) t=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/${TAPE_REPO}/releases/download/${TAPE_VERSION}"; \
    asset="tape-${t}.tar.gz"; \
    cd /tmp; \
    curl -fsSL "${base}/${asset}" -o "${asset}"; \
    curl -fsSL "${base}/${asset}.sha256" -o "${asset}.sha256"; \
    sha256sum -c "${asset}.sha256"; \
    tar -xzf "${asset}" -C /tmp --strip-components=1 "tape-${t}/tape"; \
    /tmp/tape --version

# ---- stage 1b: copy pre-staged release binary (workflow path) ---------------
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS binary-source-staged
ARG TARGETARCH
COPY dist/linux/${TARGETARCH}/tape /tmp/tape

FROM binary-source-${SOURCE} AS binary-source

# ---- stage 2: distroless static runtime — only the binary + CA certs, nonroot
# static-debian12 ships no glibc/libgcc at all; the fetched binary is a fully
# static musl build, so there is no libc-version coupling to the base image at
# all (the prior cc-debian12 + dynamically-linked gnu binary combination broke
# whenever the release runner's glibc outpaced Debian 12's — see #1195).
# :nonroot = uid 65532. A single tokio binary handles SIGTERM itself (graceful
# drain) and spawns no children, so no tini/init shim is required.
FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --chown=65532:65532 --from=binary-source /tmp/tape /usr/local/bin/tape
EXPOSE 7137
ENTRYPOINT ["/usr/local/bin/tape"]
