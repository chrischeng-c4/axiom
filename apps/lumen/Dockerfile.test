# HANDWRITE-BEGIN gap="lumen-test-image-dockerfile" tracker="2513" reason="Per-commit GHCR dev/test image variant of Dockerfile.release — COPY a locally built binary instead of downloading a published release tarball; never tagged latest/semver."
# syntax=docker/dockerfile:1
# Internal dev/test image for lumen — NEVER user-facing (see #2513). COPY
# variant of `Dockerfile.release`: same runtime stage (distroless
# static-debian12, entrypoint, port, CMD) but takes the binary from the
# build context instead of downloading a published release tarball, so it
# can be built from an unreleased commit.
#
# Produced by `.github/workflows/lumen-test-image.yml` and pushed ONLY as
# `ghcr.io/<owner>/lumen:sha-<git12>` — that workflow must never add a
# `latest` or semver tag to this image. The release line
# (`lumen:<semver>` + `latest`) stays exclusively on `Dockerfile.release`
# via `lumen-release.yml`.
#
# Expects the workflow to have staged per-arch release-profile binaries into
# the build context before invoking buildx:
#   dist/linux/amd64/lumen
#   dist/linux/arm64/lumen
#
#   docker buildx build -f apps/lumen/Dockerfile.test \
#     --platform linux/amd64,linux/arm64 \
#     -t ghcr.io/<owner>/lumen:sha-<git12> --push .

# distroless static runtime — only the binary + CA certs, nonroot. Identical
# to Dockerfile.release's runtime stage: static-debian12 ships no
# glibc/libgcc, so this only works with the fully static musl binaries the
# workflow builds (see Dockerfile.release / #1195 for why). :nonroot = uid
# 65532. A single tokio binary handles SIGTERM itself (graceful drain) and
# spawns no children, so no tini/init shim is required.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH=amd64
COPY dist/linux/${TARGETARCH}/lumen /usr/local/bin/lumen
# 7373 = client API. WAL storage is embedded locally or Lumen-owned raft state.
EXPOSE 7373
ENV LUMEN_HOST=0.0.0.0
ENTRYPOINT ["/usr/local/bin/lumen"]
CMD ["serve"]
# HANDWRITE-END
