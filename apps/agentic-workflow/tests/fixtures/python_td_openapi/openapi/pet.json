{
  "openapi": "3.1.0",
  "info": {
    "title": "Pet target profile contract",
    "version": "1.0.0"
  },
  "paths": {
    "/pets": {
      "get": {
        "operationId": "listPets",
        "responses": {
          "200": {
            "description": "Pet list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pet"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "Pet": {
        "type": "object",
        "properties": {
          "gen": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "gen",
          "name"
        ]
      }
    }
  }
}
