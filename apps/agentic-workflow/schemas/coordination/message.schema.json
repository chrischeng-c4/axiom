{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/aw/coordination/message.schema.json",
  "title": "AW Coordination Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "event_id",
    "task_id",
    "dispatch_id",
    "sequence",
    "sender",
    "message_type",
    "evidence",
    "body"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "aw.coordination.v1"
    },
    "kind": {
      "type": "string",
      "const": "message"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "message_type": {
      "type": "string",
      "enum": [
        "heartbeat",
        "completion",
        "escalation",
        "blocked_question"
      ]
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "body": {
      "type": "object"
    }
  }
}
