{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom.dev/schemas/aw/coordination/dispatch.schema.json",
  "title": "AW Coordination Dispatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "task_id",
    "dispatch_id",
    "attempt",
    "assignee",
    "authority",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "aw.coordination.v1"
    },
    "kind": {
      "type": "string",
      "const": "dispatch"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "assignee": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "const": "aw"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "superseded",
        "interrupted"
      ]
    }
  }
}
