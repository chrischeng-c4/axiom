# syntax=docker/dockerfile:1
# Production image for loom — downloads a PUBLISHED release binary (no source
# tree, no Rust toolchain) into a slim runtime. The sibling `Dockerfile` is the
# from-source build for dev / CI. Rendered by `loom dockerfile render --variant
# release`.
#
#   docker build -f projects/loom/Dockerfile.release -t loom:0.4.3 \
#     --build-arg LOOM_VERSION=loom@0.4.3 .
#
# The image arch (BuildKit TARGETARCH) selects the matching linux tarball:
#   --platform linux/amd64 → x86_64-unknown-linux-gnu
#   --platform linux/arm64 → aarch64-unknown-linux-gnu

# ---- stage 1: fetch + verify the release binary (needs shell + curl) --------
FROM debian:bookworm-slim AS fetch
ARG LOOM_VERSION=loom@0.4.3
ARG LOOM_REPO=chrischeng-c4/axiom
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) t=x86_64-unknown-linux-gnu ;; \
      arm64) t=aarch64-unknown-linux-gnu ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/${LOOM_REPO}/releases/download/${LOOM_VERSION}"; \
    curl -fsSL "${base}/loom-${t}.tar.gz"        -o /tmp/loom.tgz; \
    curl -fsSL "${base}/loom-${t}.tar.gz.sha256" -o /tmp/loom.sha256; \
    echo "$(cat /tmp/loom.sha256)  /tmp/loom.tgz" | sha256sum -c -; \
    tar -xzf /tmp/loom.tgz -C /tmp --strip-components=1 "loom-${t}/loom"; \
    /tmp/loom --version

# ---- stage 2: slim runtime — the loom binary + kubectl, non-root -------------
# debian-slim (not distroless): `loom job-controller` shells kubectl to create
# Jobs via the pod's ServiceAccount token, so the runtime needs kubectl.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && ARCH=$(dpkg --print-architecture) \
    && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/v1.31.3/bin/linux/${ARCH}/kubectl" \
    && chmod +x /usr/local/bin/kubectl \
    && apt-get purge -y curl && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* \
    && useradd -u 65532 -M -s /usr/sbin/nologin nonroot
COPY --chown=65532:65532 --from=fetch /tmp/loom /usr/local/bin/loom
USER 65532
# 7474 = controller control API; 7475 = schema-layer bidi edge (both h2c+HTTP/1).
EXPOSE 7474 7475
ENTRYPOINT ["/usr/local/bin/loom"]
CMD ["controller"]
