# HANDWRITE-BEGIN gap="sift-test-image-dockerfile" tracker="2513" reason="Per-commit GHCR dev/test image variant of Dockerfile.release — COPY a locally built binary instead of downloading a published release tarball; never tagged latest/semver."
# syntax=docker/dockerfile:1
# Internal dev/test image for sift — NEVER user-facing (see #2513). COPY
# variant of `Dockerfile.release`: same runtime stage (distroless
# static-debian12, env, volume, port, entrypoint/CMD) but takes the binary
# from the build context instead of downloading a published release
# tarball, so it can be built from an unreleased commit.
#
# Produced by `.github/workflows/sift-test-image.yml` and pushed ONLY as
# `ghcr.io/<owner>/sift:sha-<git12>` — that workflow must never add a
# `latest` or semver tag to this image.
#
# Expects the workflow to have staged per-arch release-profile binaries into
# the build context before invoking buildx:
#   dist/linux/amd64/sift
#   dist/linux/arm64/sift
#
#   docker buildx build -f apps/sift/Dockerfile.test \
#     --platform linux/amd64,linux/arm64 \
#     -t ghcr.io/<owner>/sift:sha-<git12> --push .

# Prepare the empty durable root in a stage with install(1); distroless has no
# shell or ownership tools.
FROM debian:bookworm-slim AS data-root
RUN install -d -m 0700 -o 65532 -g 65532 /image-root/var/lib/sift

# distroless static runtime — only the binary + CA certs, nonroot. Identical
# to Dockerfile.release's runtime stage; static-debian12 ships no
# glibc/libgcc, so this only works with the fully static musl binaries the
# workflow builds.
FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH=amd64
COPY dist/linux/${TARGETARCH}/sift /usr/local/bin/sift
COPY --from=data-root --chown=65532:65532 --chmod=0700 /image-root/var/lib/sift /var/lib/sift
ENV SIFT_HOST=0.0.0.0 \
    SIFT_PORT=7380 \
    SIFT_DATA_DIR=/var/lib/sift \
    SIFT_LOG_FORMAT=json
VOLUME ["/var/lib/sift"]
EXPOSE 4317 7380
ENTRYPOINT ["/usr/local/bin/sift"]
CMD ["serve"]
# HANDWRITE-END
