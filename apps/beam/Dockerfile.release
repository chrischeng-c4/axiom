# syntax=docker/dockerfile:1
# Production image for beam — downloads a PUBLISHED release binary into a distroless runtime.
#
#   docker build -f apps/beam/Dockerfile.release -t beam:0.4.7 \
#     --build-arg BEAM_VERSION=beam@0.4.7 .

FROM debian:bookworm-slim AS fetch
ARG BEAM_VERSION=beam@0.4.7
ARG BEAM_REPO=chrischeng-c4/axiom
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) t=x86_64-unknown-linux-musl ;; \
      arm64) t=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/${BEAM_REPO}/releases/download/${BEAM_VERSION}"; \
    curl -fsSL "${base}/beam-${t}.tar.gz"        -o /tmp/beam.tgz; \
    curl -fsSL "${base}/beam-${t}.tar.gz.sha256" -o /tmp/beam.sha256; \
    echo "$(cat /tmp/beam.sha256)  /tmp/beam.tgz" | sha256sum -c -; \
    tar -xzf /tmp/beam.tgz -C /tmp --strip-components=1 "beam-${t}/beam"; \
    /tmp/beam --version

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=fetch /tmp/beam /usr/local/bin/beam
# 7373 = client API.
EXPOSE 7373
ENTRYPOINT ["/usr/local/bin/beam"]
CMD ["serve"]
