FROM rust:1.96-bookworm AS builder
WORKDIR /workspace
COPY . .
RUN cargo build --locked --release -p rig-cli --bin rig \
 && install -D -m 0755 target/release/rig /out/rig

FROM gcr.io/distroless/cc-debian12:nonroot
COPY --from=builder /out/rig /usr/local/bin/rig
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/rig"]
CMD ["--help"]
