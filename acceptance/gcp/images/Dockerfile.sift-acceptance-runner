FROM rust:1.96-bookworm AS builder
ARG SOURCE_REVISION
WORKDIR /workspace
COPY . .
RUN test -n "${SOURCE_REVISION}" \
 && SIFT_SOURCE_REVISION="${SOURCE_REVISION}" \
    cargo build --locked --release -p sift --bin sift \
 && install -D -m 0755 target/release/sift /out/sift

FROM hashicorp/terraform:1.9.4 AS terraform

# This is a test controller. It is not deployed to GKE. The host starts it as
# its own non-root UID, with a read-only root filesystem and no Docker socket.
FROM gcr.io/google.com/cloudsdktool/google-cloud-cli:581.0.0-debian_component_based
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash ca-certificates coreutils curl findutils gzip jq mawk openssl procps \
      python3 python3-jsonschema ripgrep sed tar \
 && gcloud components install --quiet gke-gcloud-auth-plugin kubectl \
 && groupadd --gid 65532 sift-acceptance \
 && useradd --uid 65532 --gid 65532 --no-create-home \
      --shell /usr/sbin/nologin sift-acceptance \
 && rm -rf /var/lib/apt/lists/*
COPY --from=terraform /bin/terraform /usr/local/bin/terraform
COPY --from=builder /out/sift /usr/local/bin/sift
COPY . /workspace
ENV HOME=/tmp/sift-acceptance-home \
    SIFT_CLI=/usr/local/bin/sift
WORKDIR /workspace
USER 65532:65532
ENTRYPOINT ["/bin/bash"]
CMD ["/workspace/acceptance/gcp/scripts/run.sh"]
