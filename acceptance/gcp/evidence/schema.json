{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cclab.dev/axiom/gcp-operator-acceptance/v1",
  "title": "Axiom GCP operator acceptance evidence",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "region",
    "run_id",
    "acceptance"
  ],
  "properties": {
    "schema": {
      "const": "axiom.gcp.operator.acceptance.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 6
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "gke_zone": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,17}$"
    },
    "backup_bucket": {
      "type": "string",
      "minLength": 1
    },
    "lumen_evidence": {
      "type": "string",
      "minLength": 1
    },
    "lumen_provenance": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "lumen": {
          "type": "object",
          "required": [
            "operator_reconcile_1x1",
            "gcs_backup_before_split",
            "auto_split_delta",
            "cpu_memory_actuator",
            "live_replica_membership",
            "dedicated_node_pool_placement",
            "control_plane_fleet"
          ]
        },
        "auth": {
          "type": "object",
          "required": ["schema", "run_id", "project_id", "issuers", "rows", "sibling_mint_refusals", "revocation", "status"],
          "properties": {
            "schema": {"const": "axiom.gcp.lumen.auth.acceptance.v1"},
            "status": {"const": "passed"},
            "rows": {
              "type": "object",
              "required": ["identity_observations", "non_ksa_rejections", "authorization", "sibling_refusals", "revocations", "redaction", "teardown"],
              "additionalProperties": false,
              "properties": {
                "identity_observations": {"type": "integer", "minimum": 1},
                "non_ksa_rejections": {"type": "integer", "minimum": 1},
                "authorization": {"type": "integer", "minimum": 1},
                "sibling_refusals": {"type": "integer", "minimum": 1},
                "revocations": {"type": "integer", "minimum": 1},
                "redaction": {"type": "integer", "minimum": 1},
                "teardown": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "sift": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "schema",
                "operator_reconcile_1x1",
                "scheduled_backup",
                "gcs_backup",
                "topology_beyond_1x1"
              ],
              "properties": {
                "schema": {"const": "axiom.gcp.sift.acceptance.v1"}
              }
            },
            {
              "required": [
                "schema",
                "status",
                "candidate",
                "topology",
                "protocols",
                "load",
                "latency",
                "failover",
                "archive",
                "idempotency",
                "retention",
                "restore",
                "cleanup_evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "schema": {"const": "axiom.gcp.sift.mvp.acceptance.v1"},
                "status": {"const": "passed"},
                "candidate": {
                  "type": "object",
                  "required": ["sift_image", "rig_image", "acceptance_runner_image", "git_sha", "source_bundle_sha256", "cloud_build_id", "source_object_uri", "immutable"],
                  "additionalProperties": false,
                  "properties": {
                    "sift_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
                    "rig_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
                    "acceptance_runner_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
                    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                    "source_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "cloud_build_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,128}$"},
                    "source_object_uri": {"type": "string", "pattern": "^gs://"},
                    "immutable": {"const": true}
                  }
                },
                "topology": {
                  "type": "object",
                  "required": ["store_voters", "control_replicas", "gateway_replicas", "query_replicas", "peer_mtls", "pvc_restart"],
                  "additionalProperties": false,
                  "properties": {
                    "store_voters": {"const": 3},
                    "control_replicas": {"const": 3},
                    "gateway_replicas": {"const": 1},
                    "query_replicas": {"const": 1},
                    "peer_mtls": {"const": "passed"},
                    "pvc_restart": {"const": "passed"}
                  }
                },
                "protocols": {
                  "type": "object",
                  "required": ["otlp_http_json", "otlp_http_protobuf", "otlp_gzip", "otlp_grpc", "partial_success", "remote_write_1", "prometheus_query_range", "remote_write_2_rejected_415", "mcp_read_only_tools", "mcp_host_origin", "cross_project_denied", "cross_project_same_id"],
                  "additionalProperties": false,
                  "properties": {
                    "otlp_http_json": {"const": "passed"},
                    "otlp_http_protobuf": {"const": "passed"},
                    "otlp_gzip": {"const": "passed"},
                    "otlp_grpc": {"const": "passed"},
                    "partial_success": {"const": "passed"},
                    "remote_write_1": {"const": "passed"},
                    "prometheus_query_range": {"const": "passed"},
                    "remote_write_2_rejected_415": {"const": "passed"},
                    "mcp_read_only_tools": {"const": "passed"},
                    "mcp_host_origin": {"const": "passed"},
                    "cross_project_denied": {"const": "passed"},
                    "cross_project_same_id": {"const": "passed"}
                  }
                },
                "load": {
                  "type": "object",
                  "required": ["duration_seconds", "offered_items_per_second", "expected_unique_items", "expected_logs", "expected_metric_points", "expected_spans", "observed", "event_id_digest"],
                  "additionalProperties": false,
                  "properties": {
                    "duration_seconds": {"const": 1800},
                    "offered_items_per_second": {"const": 10000},
                    "expected_unique_items": {"const": 18000000},
                    "expected_logs": {"const": 9000000},
                    "expected_metric_points": {"const": 5400000},
                    "expected_spans": {"const": 3600000},
                    "observed": {
                      "type": "object",
                      "required": ["requests", "failed", "achieved_items_per_second", "p95_ms", "p99_ms"],
                      "additionalProperties": false,
                      "properties": {
                        "requests": {"const": 18000},
                        "failed": {"const": 0},
                        "achieved_items_per_second": {"type": "number", "minimum": 9500},
                        "p95_ms": {"type": "number", "maximum": 250},
                        "p99_ms": {"type": "number", "maximum": 1000}
                      }
                    },
                    "event_id_digest": {
                      "type": "object",
                      "required": ["algorithm", "expected", "observed", "match"],
                      "additionalProperties": false,
                      "properties": {
                        "algorithm": {"const": "xor-sha256-v1"},
                        "expected": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "observed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "match": {"const": true}
                      }
                    }
                  }
                },
                "latency": {
                  "type": "object",
                  "required": ["query_p95_ms", "trace_read_p95_ms", "tail_visible_ms"],
                  "additionalProperties": false,
                  "properties": {
                    "query_p95_ms": {"type": "number", "maximum": 2000},
                    "trace_read_p95_ms": {"type": "number", "maximum": 1000},
                    "tail_visible_ms": {"type": "number", "maximum": 2000}
                  }
                },
                "failover": {
                  "type": "object",
                  "required": ["duration_seconds", "expected_unique_items", "leader_before", "leader_after", "stopped_vm", "observed", "event_id_digest", "acknowledged_data_loss", "auto_repair"],
                  "additionalProperties": false,
                  "properties": {
                    "duration_seconds": {"const": 300},
                    "expected_unique_items": {"const": 3000000},
                    "leader_before": {"type": "string", "minLength": 1},
                    "leader_after": {"type": "string", "minLength": 1},
                    "stopped_vm": {"type": "string", "minLength": 1},
                    "observed": {
                      "type": "object",
                      "required": ["requests", "failed", "achieved_items_per_second", "p95_ms", "p99_ms"],
                      "additionalProperties": false,
                      "properties": {
                        "requests": {"const": 3000},
                        "failed": {"const": 0},
                        "achieved_items_per_second": {"type": "number", "minimum": 9500},
                        "p95_ms": {"type": "number", "maximum": 250},
                        "p99_ms": {"type": "number", "maximum": 1000}
                      }
                    },
                    "event_id_digest": {
                      "type": "object",
                      "required": ["algorithm", "expected", "observed", "match"],
                      "additionalProperties": false,
                      "properties": {
                        "algorithm": {"const": "xor-sha256-v1"},
                        "expected": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "observed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "match": {"const": true}
                      }
                    },
                    "acknowledged_data_loss": {"const": 0},
                    "auto_repair": {"const": "passed"}
                  }
                },
                "archive": {
                  "type": "object",
                  "required": ["gcs_iam_outage", "wal_preserved", "quorum_recovered_after_leader_restart", "manifest_uri"],
                  "additionalProperties": false,
                  "properties": {
                    "gcs_iam_outage": {"const": "passed"},
                    "wal_preserved": {"const": "passed"},
                    "quorum_recovered_after_leader_restart": {"const": true},
                    "manifest_uri": {"type": "string", "pattern": "^gs://"}
                  }
                },
                "idempotency": {
                  "type": "object",
                  "required": ["signals", "immediate_retry", "after_steady_load", "after_vm_failover", "after_telemetry_expiration"],
                  "additionalProperties": false,
                  "properties": {
                    "signals": {"const": ["logs", "metrics", "traces"]},
                    "immediate_retry": {"const": "passed"},
                    "after_steady_load": {"const": "passed"},
                    "after_vm_failover": {"const": "passed"},
                    "after_telemetry_expiration": {"const": "passed"}
                  }
                },
                "retention": {
                  "type": "object",
                  "required": ["day_29", "day_31", "day_181", "day_180_rollover", "scan_completed"],
                  "additionalProperties": false,
                  "properties": {
                    "day_29": {"const": "hot-query-passed"},
                    "day_31": {"const": "cold-query-passed"},
                    "day_181": {"const": "non-retryable-partial-rejection-passed"},
                    "day_180_rollover": {"const": "bounded-generation-passed"},
                    "scan_completed": {"const": true}
                  }
                },
                "restore": {
                  "type": "object",
                  "required": ["fresh_pvc", "new_cluster_id", "restored_from", "source_count", "restored_count", "source_digest", "restored_digest", "source_watermark", "restored_watermark"],
                  "additionalProperties": false,
                  "properties": {
                    "fresh_pvc": {"const": "passed"},
                    "new_cluster_id": {"const": true},
                    "restored_from": {"type": "string", "pattern": "^gs://"},
                    "source_count": {"type": "integer", "minimum": 18000000},
                    "restored_count": {"type": "integer", "minimum": 18000000},
                    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "restored_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "source_watermark": {"type": "integer", "minimum": 1},
                    "restored_watermark": {"type": "integer", "minimum": 1}
                  }
                },
                "cleanup_evidence": {
                  "type": "object",
                  "required": [
                    "schema",
                    "project_id",
                    "region",
                    "gke_zone",
                    "run_id",
                    "verified_at",
                    "status",
                    "candidate",
                    "preserved"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "schema": {"const": "axiom.gcp.operator.cleanup.v1"},
                    "project_id": {"type": "string", "minLength": 6},
                    "region": {"type": "string", "minLength": 1},
                    "gke_zone": {"type": "string", "minLength": 1},
                    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,17}$"},
                    "verified_at": {"type": "string", "minLength": 20},
                    "status": {"const": "clean"},
                    "candidate": {
                      "type": "object",
                      "required": ["sift_image", "rig_image", "acceptance_runner_image", "git_sha", "source_bundle_sha256", "cloud_build_id", "source_object_uri", "immutable"],
                      "additionalProperties": false,
                      "properties": {
                        "sift_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
                        "rig_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
                        "acceptance_runner_image": {"type": "string", "pattern": "@sha256:[0-9a-f]{64}$"},
                        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                        "source_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                        "cloud_build_id": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,128}$"},
                        "source_object_uri": {"type": "string", "pattern": "^gs://"},
                        "immutable": {"const": true}
                      }
                    },
                    "preserved": {
                      "type": "object",
                      "required": ["artifact_registry", "preexisting_apis"],
                      "additionalProperties": false,
                      "properties": {
                        "artifact_registry": {"const": true},
                        "preexisting_apis": {"const": true}
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "tape": {
          "type": "object",
          "required": [
            "operator_reconcile_1x1",
            "append_replay_lifecycle",
            "subscription_pull_ack_cursor",
            "subscription_lag_gauge",
            "pod_restart_data_retention",
            "gcs_backup",
            "gcs_object",
            "gcs_object_bytes",
            "cold_restore_from_backup",
            "bootstrap_seed_uri_restart",
            "seed_cleared_rolling_restart_retention",
            "topology_1_to_3",
            "raft_failover",
            "post_failover_write_committed"
          ]
        }
      },
      "oneOf": [
        {
          "required": ["lumen", "auth", "sift"]
        },
        {
          "required": ["auth"],
          "not": {"anyOf": [{"required": ["lumen"]}, {"required": ["sift"]}, {"required": ["tape"]}]}
        },
        {
          "required": ["tape"]
        },
        {
          "required": ["sift"],
          "not": {"anyOf": [{"required": ["lumen"]}, {"required": ["auth"]}, {"required": ["tape"]}]},
          "properties": {
            "sift": {
              "required": ["schema"],
              "properties": {"schema": {"const": "axiom.gcp.sift.mvp.acceptance.v1"}}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "required": ["acceptance"],
      "properties": {"acceptance": {"required": ["auth"], "not": {"required": ["tape"]}}},
      "not": {"anyOf": [{"required": ["backup_bucket"]}, {"required": ["lumen_evidence"]}, {"required": ["lumen_provenance"]}]}
    },
    {
      "required": ["backup_bucket", "lumen_evidence", "lumen_provenance", "acceptance"],
      "properties": {"acceptance": {"required": ["lumen", "auth", "sift"]}}
    },
    {
      "required": ["backup_bucket", "acceptance"],
      "properties": {"acceptance": {"required": ["tape"]}}
    },
    {
      "required": ["backup_bucket", "acceptance"],
      "properties": {
        "acceptance": {
          "required": ["sift"],
          "not": {"anyOf": [{"required": ["lumen"]}, {"required": ["auth"]}, {"required": ["tape"]}]},
          "properties": {
            "sift": {
              "required": ["schema"],
              "properties": {"schema": {"const": "axiom.gcp.sift.mvp.acceptance.v1"}}
            }
          }
        }
      },
      "not": {"anyOf": [{"required": ["lumen_evidence"]}, {"required": ["lumen_provenance"]}]}
    }
  ],
  "additionalProperties": false
}
